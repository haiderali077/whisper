PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27018/whisper
JWT_SECRET=replace-with-a-long-random-secret-shared-by-all-instances
REDIS_URL=redis://127.0.0.1:6380
REDIS_PREFIX=whisper
INSTANCE_ID=backend-local
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Only enable when all backend traffic must pass through exactly one trusted proxy.
# TRUST_PROXY=1
# SERVE_FRONTEND=true
PRESENCE_HEARTBEAT_MS=10000
PRESENCE_LEASE_MS=30000
RATE_LIMIT_AUTH=20
RATE_LIMIT_API=300
RATE_LIMIT_SEND=60
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_RECEIPTS=120
RATE_LIMIT_HANDSHAKES=60
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
